<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="safe_drive_signal_intersection">
    <plugin name="safe_drive_ground_truth" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/safe_drive/gazebo</namespace>
      </ros>
      <update_rate>20.0</update_rate>
    </plugin>
    <physics name="ode" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <gravity>0 0 -9.81</gravity>
    <magnetic_field>6e-6 2.3e-5 -4.2e-5</magnetic_field>
    <atmosphere type="adiabatic"/>

    <!-- Catch vehicles that leave the finite test road while a controller is
         being developed. The road surface remains the active driving plane. -->
    <include>
      <uri>model://ground_plane</uri>
      <pose>0 0 -0.1 0 0 0</pose>
    </include>

    <scene>
      <ambient>0.45 0.45 0.45 1</ambient>
      <background>0.70 0.85 1.0 1</background>
      <shadows>true</shadows>
    </scene>

    <gui>
      <camera name="user_camera">
        <track_visual>
          <name>safe_drive_ego</name>
          <static>true</static>
          <use_model_frame>true</use_model_frame>
          <xyz>-12 0 8</xyz>
        </track_visual>
      </camera>
    </gui>

    <light name="sun" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="road">
      <static>true</static>
      <link name="road_link">
        <collision name="collision">
          <pose>-45 0 -0.05 0 0 0</pose>
          <geometry><box><size>390 8 0.1</size></box></geometry>
          <surface>
            <friction><ode><mu>1.0</mu><mu2>1.0</mu2></ode></friction>
          </surface>
        </collision>
        <visual name="asphalt">
          <pose>-45 0 -0.045 0 0 0</pose>
          <geometry><box><size>390 8 0.01</size></box></geometry>
          <material>
            <script>
              <uri>file://safe_drive_road/materials/scripts</uri>
              <uri>file://safe_drive_road/materials/textures</uri>
              <name>SafeDrive/Asphalt</name>
            </script>
          </material>
        </visual>
        <visual name="center_line_a">
          <pose>-127 0 -0.037 0 0 0</pose>
          <geometry><box><size>226 0.12 0.01</size></box></geometry>
          <material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material>
        </visual>
        <visual name="center_line_c">
          <pose>80 0 -0.037 0 0 0</pose>
          <geometry><box><size>140 0.12 0.01</size></box></geometry>
          <material><ambient>0.95 0.85 0.10 1</ambient><diffuse>0.95 0.85 0.10 1</diffuse></material>
        </visual>
        <visual name="left_edge_line_west">
          <pose>-125 3.75 -0.037 0 0 0</pose>
          <geometry><box><size>230 0.12 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="left_edge_line_east">
          <pose>80 3.75 -0.037 0 0 0</pose>
          <geometry><box><size>140 0.12 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="right_edge_line_west">
          <pose>-125 -3.75 -0.037 0 0 0</pose>
          <geometry><box><size>230 0.12 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <visual name="right_edge_line_east">
          <pose>80 -3.75 -0.037 0 0 0</pose>
          <geometry><box><size>140 0.12 0.01</size></box></geometry>
          <material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material>
        </visual>
        <!-- Zebra bars run parallel to east-west vehicle travel, repeated
             across the pedestrian's north-south path. Paint has no collision. -->
        <visual name="crosswalk_bar_1"><pose>-5 -3.45 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_2"><pose>-5 -2.45 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_3"><pose>-5 -1.45 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_4"><pose>-5 -0.45 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_5"><pose>-5 0.55 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_6"><pose>-5 1.55 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_7"><pose>-5 2.55 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="crosswalk_bar_8"><pose>-5 3.55 -0.030 0 0 0</pose><geometry><box><size>3.6 0.50 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <!-- The 0.30 m approach line ends 2.3 m before the nearest bar.
             Other approaches stop outside the central intersection square. -->
        <visual name="eastbound_stop_line"><pose>-9.25 -1.75 -0.029 0 0 0</pose><geometry><box><size>0.30 3.30 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
        <visual name="westbound_stop_line"><pose>8.4 1.75 -0.029 0 0 0</pose><geometry><box><size>0.30 3.30 0.012</size></box></geometry><material><ambient>0.96 0.96 0.94 1</ambient><diffuse>0.96 0.96 0.94 1</diffuse></material></visual>
      </link>
    </model>
    <!-- The original east-west collision plane covers the central square.
         North and south arms meet it at their edges. The south arm continues
         beyond the right-turn destination, leaving room to settle on road. -->
    <model name="cross_road">
      <static>true</static>
      <link name="surface">
        <collision name="north_road_collision"><pose>2 13 -0.05 0 0 0</pose><geometry><box><size>8 18 0.1</size></box></geometry></collision>
        <collision name="south_road_collision"><pose>2 -23 -0.05 0 0 0</pose><geometry><box><size>8 38 0.1</size></box></geometry></collision>
        <visual name="north_asphalt"><pose>2 13 -0.045 0 0 0</pose><geometry><box><size>8 18 0.01</size></box></geometry><material><script><uri>file://safe_drive_road/materials/scripts</uri><uri>file://safe_drive_road/materials/textures</uri><name>SafeDrive/Asphalt</name></script></material></visual>
        <visual name="south_asphalt"><pose>2 -23 -0.045 0 0 0</pose><geometry><box><size>8 38 0.01</size></box></geometry><material><script><uri>file://safe_drive_road/materials/scripts</uri><uri>file://safe_drive_road/materials/textures</uri><name>SafeDrive/Asphalt</name></script></material></visual>
        <visual name="north_center_line"><pose>2 13 -0.035 0 0 0</pose><geometry><box><size>0.12 13 0.012</size></box></geometry><material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="south_center_line"><pose>2 -23 -0.035 0 0 0</pose><geometry><box><size>0.12 33 0.012</size></box></geometry><material><ambient>0.95 0.85 0.1 1</ambient><diffuse>0.95 0.85 0.1 1</diffuse></material></visual>
        <visual name="south_west_edge_line"><pose>-1.75 -24 -0.035 0 0 0</pose><geometry><box><size>0.10 34 0.012</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
        <visual name="south_east_edge_line"><pose>5.75 -24 -0.035 0 0 0</pose><geometry><box><size>0.10 34 0.012</size></box></geometry><material><ambient>0.95 0.95 0.95 1</ambient><diffuse>0.95 0.95 0.95 1</diffuse></material></visual>
      </link>
    </model>
    <!-- Roadside vehicle signal: three horizontal circular aspects face
         approaching eastbound traffic. It is independent of the pedestrian face. -->
    <model name="vehicle_signal_fixture"><static>true</static><link name="post">
      <visual name="pole"><pose>-8.0 -4.72 1.48 0 0 0</pose><geometry><cylinder><radius>0.075</radius><length>2.96</length></cylinder></geometry><material><ambient>0.20 0.23 0.25 1</ambient><diffuse>0.31 0.34 0.36 1</diffuse></material></visual>
      <visual name="housing"><pose>-8.0 -4.10 3.00 0 0 0</pose><geometry><box><size>0.30 1.78 0.52</size></box></geometry><material><ambient>0.035 0.045 0.05 1</ambient><diffuse>0.065 0.075 0.085 1</diffuse></material></visual>
      <visual name="bracket"><pose>-8.0 -4.43 2.98 0 0 0</pose><geometry><box><size>0.12 0.67 0.10</size></box></geometry><material><ambient>0.20 0.23 0.25 1</ambient><diffuse>0.31 0.34 0.36 1</diffuse></material></visual>
      <visual name="red_lens"><pose>-8.19 -3.55 3.00 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.18 0.025 0.02 1</ambient><diffuse>0.18 0.025 0.02 1</diffuse></material></visual>
      <visual name="yellow_lens"><pose>-8.19 -4.1 3.00 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.18 0.11 0.015 1</ambient><diffuse>0.18 0.11 0.015 1</diffuse></material></visual>
      <visual name="green_lens"><pose>-8.19 -4.65 3.00 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.015 0.15 0.025 1</ambient><diffuse>0.015 0.15 0.025 1</diffuse></material></visual>
    </link></model>
    <!-- Pedestrian signal: two square aspects at the south curb. Its lit face
         points north (+y) toward the crossing and the following camera. -->
    <model name="pedestrian_signal_fixture"><static>true</static><link name="post">
      <visual name="pole"><pose>-3.3 -4.68 1.04 0 0 0</pose><geometry><cylinder><radius>0.05</radius><length>2.08</length></cylinder></geometry><material><ambient>0.20 0.23 0.25 1</ambient><diffuse>0.31 0.34 0.36 1</diffuse></material></visual>
      <visual name="housing"><pose>-3.3 -4.70 2.08 0 0 0</pose><geometry><box><size>0.48 0.23 0.83</size></box></geometry><material><ambient>0.035 0.045 0.05 1</ambient><diffuse>0.065 0.075 0.085 1</diffuse></material></visual>
      <visual name="dont_walk_lens"><pose>-3.3 -4.56 2.27 0 0 0</pose><geometry><box><size>0.31 0.025 0.30</size></box></geometry><material><ambient>0.17 0.025 0.02 1</ambient><diffuse>0.17 0.025 0.02 1</diffuse></material></visual>
      <visual name="walk_lens"><pose>-3.3 -4.56 1.89 0 0 0</pose><geometry><box><size>0.31 0.025 0.30</size></box></geometry><material><ambient>0.02 0.15 0.04 1</ambient><diffuse>0.02 0.15 0.04 1</diffuse></material></visual>
    </link></model>
    <model name="vehicle_red_lamp"><static>false</static><pose>-8.43 -3.55 3.0 0 0 0</pose><link name="bulb"><gravity>false</gravity><visual name="lit"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>1 0.035 0.025 1</ambient><diffuse>1 0.035 0.025 1</diffuse><emissive>1 0.035 0.025 1</emissive></material></visual></link></model>
    <model name="vehicle_yellow_lamp"><static>false</static><pose>-8.43 -4.1 -2.0 0 0 0</pose><link name="bulb"><gravity>false</gravity><visual name="lit"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>1 0.60 0.02 1</ambient><diffuse>1 0.60 0.02 1</diffuse><emissive>1 0.60 0.02 1</emissive></material></visual></link></model>
    <model name="vehicle_green_lamp"><static>false</static><pose>-8.43 -4.65 -2.0 0 0 0</pose><link name="bulb"><gravity>false</gravity><visual name="lit"><geometry><sphere><radius>0.15</radius></sphere></geometry><material><ambient>0.03 0.95 0.08 1</ambient><diffuse>0.03 0.95 0.08 1</diffuse><emissive>0.03 0.95 0.08 1</emissive></material></visual></link></model>
    <model name="pedestrian_dont_walk_lamp"><static>false</static><pose>-3.3 -4.53 2.27 0 0 0</pose><link name="bulb"><gravity>false</gravity><visual name="lit"><geometry><box><size>0.26 0.025 0.25</size></box></geometry><material><ambient>1 0.04 0.03 1</ambient><diffuse>1 0.04 0.03 1</diffuse><emissive>1 0.04 0.03 1</emissive></material></visual></link></model>
    <model name="pedestrian_walk_lamp"><static>false</static><pose>-3.3 -4.53 -2.0 0 0 0</pose><link name="bulb"><gravity>false</gravity><visual name="lit"><geometry><box><size>0.26 0.025 0.25</size></box></geometry><material><ambient>0.03 0.95 0.08 1</ambient><diffuse>0.03 0.95 0.08 1</diffuse><emissive>0.03 0.95 0.08 1</emissive></material></visual></link></model>
    <model name="roadside">
      <static>true</static>
      <link name="streetscape">
        <visual name="north_grass_west">
          <pose>-125 7.0 -0.06 0 0 0</pose>
          <geometry><box><size>230 6 0.08</size></box></geometry>
          <material><script><uri>file://safe_drive_road/materials/scripts</uri><uri>file://safe_drive_road/materials/textures</uri><name>SafeDrive/Grass</name></script></material>
        </visual>
