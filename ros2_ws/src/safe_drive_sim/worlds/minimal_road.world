          <geometry><box><size>0.65 0.08 0.65</size></box></geometry>
          <material><ambient>0.08 0.25 0.67 1</ambient><diffuse>0.10 0.37 0.85 1</diffuse></material>
        </visual>
        <visual name="south_tree_trunk">
          <pose>11 -6.6 1.3 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.27 0.15 0.07 1</ambient><diffuse>0.39 0.23 0.10 1</diffuse></material>
        </visual>
        <visual name="south_tree_crown">
          <pose>11 -6.6 3.1 0 0 0</pose>
          <geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.09 0.27 0.07 1</ambient><diffuse>0.16 0.45 0.12 1</diffuse></material>
        </visual>
        <visual name="north_tree_trunk">
          <pose>-13 6.6 1.3 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>2.6</length></cylinder></geometry>
          <material><ambient>0.27 0.15 0.07 1</ambient><diffuse>0.39 0.23 0.10 1</diffuse></material>
        </visual>
        <visual name="north_tree_crown">
          <pose>-13 6.6 3.1 0 0 0</pose>
          <geometry><sphere><radius>1.1</radius></sphere></geometry>
          <material><ambient>0.09 0.27 0.07 1</ambient><diffuse>0.16 0.45 0.12 1</diffuse></material>
