<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Simulator-independent geometry shared by the plain and Gazebo models. -->
  <xacro:macro name="safe_drive_ego_vehicle" params="use_reference_mesh:=true">
    <xacro:property name="chassis_length" value="4.20"/>
    <xacro:property name="chassis_width" value="1.80"/>
    <xacro:property name="chassis_height" value="1.20"/>
    <xacro:property name="wheel_radius" value="0.30"/>
    <xacro:property name="wheel_width" value="0.18"/>

    <material name="blue">
      <color rgba="0.10 0.35 0.80 1.0"/>
    </material>
    <material name="black">
      <color rgba="0.05 0.05 0.05 1.0"/>
    </material>
    <material name="glass">
      <color rgba="0.13 0.22 0.28 1.0"/>
    </material>
    <material name="lamp">
      <color rgba="0.92 0.91 0.78 1.0"/>
    </material>
    <material name="paint_highlight"><color rgba="0.20 0.55 0.88 1"/></material>
    <material name="dark_trim"><color rgba="0.025 0.035 0.045 1"/></material>
    <material name="silver"><color rgba="0.57 0.64 0.69 1"/></material>
    <material name="tail_lamp"><color rgba="0.82 0.055 0.035 1"/></material>

    <link name="base_footprint"/>

    <joint name="base_footprint_joint" type="fixed">
      <parent link="base_footprint"/>
      <child link="base_link"/>
      <origin xyz="0 0 0.75" rpy="0 0 0"/>
    </joint>

    <link name="base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="120.0"/>
        <inertia ixx="30.6" ixy="0.0" ixz="0.0" iyy="158.8" iyz="0.0" izz="187.2"/>
      </inertial>
      <!-- The Prius exterior is from osrf/car_demo. Keep the SAFE-Drive
           collision and dynamics independent of its visual mesh. -->
      <xacro:if value="${use_reference_mesh}">
        <visual name="prius_body">
          <origin xyz="0 0 -0.75" rpy="0 0 1.57079632679"/>
          <geometry>
            <mesh filename="file://$(find safe_drive_description)/meshes/prius/hybrid_body.obj"
                  scale="0.009 0.009 0.01"/>
          </geometry>
        </visual>
      </xacro:if>
      <xacro:unless value="${use_reference_mesh}">
      <!-- Earlier primitive exterior remains available for asset diagnosis. -->
      <visual name="lower_body">
        <origin xyz="0 0 -0.12" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} 0.70"/>
        </geometry>
        <material name="blue"/>
      </visual>
      <visual name="body_shoulder">
        <origin xyz="0 0 0.19" rpy="0 0 0"/>
        <geometry><box size="4.08 1.76 0.20"/></geometry>
        <material name="paint_highlight"/>
      </visual>
      <visual name="cabin_glass">
        <origin xyz="-0.30 0 0.49" rpy="0 0 0"/>
        <geometry><box size="2.15 1.49 0.50"/></geometry>
        <material name="glass"/>
      </visual>
      <visual name="roof">
        <origin xyz="-0.36 0 0.79" rpy="0 0 0"/>
        <geometry><box size="1.70 1.52 0.10"/></geometry>
        <material name="blue"/>
      </visual>
      <visual name="front_pillar">
        <origin xyz="0.73 0 0.54" rpy="0 -0.40 0"/>
        <geometry><box size="0.10 1.53 0.56"/></geometry>
        <material name="blue"/>
      </visual>
      <visual name="rear_pillar">
        <origin xyz="-1.30 0 0.54" rpy="0 0.43 0"/>
        <geometry><box size="0.10 1.53 0.56"/></geometry>
        <material name="blue"/>
      </visual>
      <visual name="left_center_pillar">
        <origin xyz="-0.30 0.755 0.49" rpy="0 0 0"/>
        <geometry><box size="0.09 0.035 0.50"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="right_center_pillar">
        <origin xyz="-0.30 -0.755 0.49" rpy="0 0 0"/>
        <geometry><box size="0.09 0.035 0.50"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="left_side_sill">
        <origin xyz="0 0.906 -0.36" rpy="0 0 0"/>
        <geometry><box size="2.45 0.028 0.08"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="right_side_sill">
        <origin xyz="0 -0.906 -0.36" rpy="0 0 0"/>
        <geometry><box size="2.45 0.028 0.08"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="front_grille">
        <origin xyz="2.106 0 -0.16" rpy="0 0 0"/>
        <geometry><box size="0.014 0.83 0.19"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="front_bumper">
        <origin xyz="2.10 0 -0.37" rpy="0 0 0"/>
        <geometry><box size="0.12 1.70 0.13"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="rear_bumper">
        <origin xyz="-2.10 0 -0.37" rpy="0 0 0"/>
        <geometry><box size="0.12 1.70 0.13"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="front_left_headlamp">
        <origin xyz="2.106 0.65 0.06" rpy="0 0 0"/>
        <geometry><box size="0.014 0.35 0.14"/></geometry>
        <material name="lamp"/>
      </visual>
      <visual name="front_right_headlamp">
        <origin xyz="2.106 -0.65 0.06" rpy="0 0 0"/>
        <geometry><box size="0.014 0.35 0.14"/></geometry>
        <material name="lamp"/>
      </visual>
      <visual name="rear_left_lamp">
        <origin xyz="-2.106 0.65 0.06" rpy="0 0 0"/>
        <geometry><box size="0.014 0.35 0.14"/></geometry>
        <material name="tail_lamp"/>
      </visual>
      <visual name="rear_right_lamp">
        <origin xyz="-2.106 -0.65 0.06" rpy="0 0 0"/>
        <geometry><box size="0.014 0.35 0.14"/></geometry>
        <material name="tail_lamp"/>
      </visual>
      <visual name="left_mirror">
        <origin xyz="0.66 0.96 0.36" rpy="0 0 0"/>
        <geometry><box size="0.27 0.15 0.13"/></geometry>
        <material name="dark_trim"/>
      </visual>
      <visual name="right_mirror">
        <origin xyz="0.66 -0.96 0.36" rpy="0 0 0"/>
        <geometry><box size="0.27 0.15 0.13"/></geometry>
        <material name="dark_trim"/>
      </visual>
      </xacro:unless>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
        </geometry>
      </collision>
    </link>

    <xacro:macro name="wheel" params="name x y side">
      <link name="${name}">
        <inertial>
          <origin xyz="0 0 0" rpy="0 0 0"/>
          <mass value="2.0"/>
          <inertia ixx="0.05" ixy="0.0" ixz="0.0" iyy="0.09" iyz="0.0" izz="0.05"/>
        </inertial>
        <xacro:if value="${use_reference_mesh}">
          <visual name="prius_wheel">
            <origin xyz="0 0 0" rpy="0 0 1.57079632679"/>
            <geometry>
              <mesh filename="file://$(find safe_drive_description)/meshes/prius/wheel.obj"
                    scale="0.01 0.01 0.01"/>
            </geometry>
          </visual>
        </xacro:if>
        <xacro:unless value="${use_reference_mesh}">
          <visual name="tire">
            <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
            <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}"/></geometry>
            <material name="black"/>
          </visual>
          <visual name="outer_hub">
            <origin xyz="0 ${0.095 * side} 0" rpy="1.57079632679 0 0"/>
            <geometry><cylinder radius="0.17" length="0.012"/></geometry>
            <material name="silver"/>
          </visual>
          <visual name="hub_center">
            <origin xyz="0 ${0.103 * side} 0" rpy="1.57079632679 0 0"/>
            <geometry><cylinder radius="0.055" length="0.013"/></geometry>
            <material name="dark_trim"/>
          </visual>
        </xacro:unless>
        <collision>
          <origin xyz="0 0 0" rpy="1.57079632679 0 0"/>
          <geometry>
            <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
          </geometry>
        </collision>
      </link>
      <joint name="${name}_joint" type="continuous">
        <parent link="base_link"/>
        <child link="${name}"/>
        <origin xyz="${x} ${y} -0.45" rpy="0 0 0"/>
        <axis xyz="0 1 0"/>
        <dynamics damping="0.1" friction="0.0"/>
      </joint>
    </xacro:macro>

    <xacro:wheel name="front_left_wheel" x="1.25" y="0.78" side="1"/>
    <xacro:wheel name="front_right_wheel" x="1.25" y="-0.78" side="-1"/>
    <xacro:wheel name="rear_left_wheel" x="-1.25" y="0.78" side="1"/>
    <xacro:wheel name="rear_right_wheel" x="-1.25" y="-0.78" side="-1"/>
  </xacro:macro>
</robot>
